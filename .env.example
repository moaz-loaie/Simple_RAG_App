# Copy to .env and fill in secrets. Never commit .env.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a :free model from https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_APP_TITLE=RAG App

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_REQUEST_TIMEOUT=30

CHROMA_PERSIST_DIR=
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
FASTEMBED_MODEL=thenlper/gte-large
EXCERPT_MAX_CHARS=320
