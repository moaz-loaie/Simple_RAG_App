# Copy to `.env` and set OPENROUTER_API_KEY. Never commit `.env`.
# All other variables are optional; defaults live in `src/rag/config.py`.

OPENROUTER_API_KEY=

# --- Optional (uncomment to override defaults) ---
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_REASONING_ENABLED=false
# OLLAMA_MODEL=llama3.2
# CHROMA_PERSIST_DIR=chroma_db
#
# Advanced (OpenRouter API, timeouts, retrieval tuning):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=RAG App
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_REQUEST_TIMEOUT=30
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=3
# FASTEMBED_MODEL=thenlper/gte-large
# EXCERPT_MAX_CHARS=320
